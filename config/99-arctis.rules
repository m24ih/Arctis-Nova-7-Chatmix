# Give logged-in user access and audio group access to the Arctis wireless dongle
# Vendor ID 1038 (SteelSeries)

# Arctis Nova 7
ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2202", MODE="0660", GROUP="audio", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="2202", MODE="0660", GROUP="audio", TAG+="uaccess"

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1038", ATTR{idProduct}=="2202", TEST=="power/control", ATTR{power/control}="on"

# Arctis Nova 7 Gen 2 (Jan 2026 update)
ATTRS{idVendor}=="1038", ATTRS{idProduct}=="22a1", MODE="0660", GROUP="audio", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="22a1", MODE="0660", GROUP="audio", TAG+="uaccess"

ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1038", ATTR{idProduct}=="22a1", TEST=="power/control", ATTR{power/control}="on"

